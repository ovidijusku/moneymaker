TRADING_MODE=advisory

# Alpaca paper account: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

# Used when running without Docker. docker compose overrides this with Postgres.
# Only settings the app understands belong in this file -- it is parsed strictly.
DATABASE_URL=sqlite+aiosqlite:///./data/moneymaker.db
LOG_LEVEL=INFO

# Defaults to all 32 non-stablecoin USD pairs Alpaca lists. Narrow it to cut
# polling cost; none of them can be shorted, so every suggestion is spot-long.
# SYMBOLS=["BTC/USD","ETH/USD"]

# Position sizing. RISK_PER_TRADE is the fraction of equity lost if the stop
# trades, and it is what sets the size -- the stop distance does the rest.
RISK_PER_TRADE=0.005
MAX_POSITION_PCT=0.10
MAX_GROSS_EXPOSURE_PCT=0.60
STOP_ATR_MULTIPLE=2.0
TARGET_ATR_MULTIPLE=3.0

# Reddit app: https://www.reddit.com/prefs/apps (type: script)
ENABLE_REDDIT=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=moneymaker/0.1

# Requires a paid X API tier. Scraping X violates its ToS.
ENABLE_X=false

ACKNOWLEDGE_LIVE_TRADING_RISK=false
