TRADING_MODE=advisory

# Alpaca paper account: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

# Used when running without Docker. docker compose overrides this with Postgres.
# Only settings the app understands belong in this file -- it is parsed strictly.
DATABASE_URL=sqlite+aiosqlite:///./data/moneymaker.db
LOG_LEVEL=INFO
SYMBOLS=["BTC/USD","ETH/USD"]

# Reddit app: https://www.reddit.com/prefs/apps (type: script)
ENABLE_REDDIT=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=moneymaker/0.1

# Requires a paid X API tier. Scraping X violates its ToS.
ENABLE_X=false

ACKNOWLEDGE_LIVE_TRADING_RISK=false
